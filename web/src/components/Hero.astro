---
import TopNav from './TopNav.astro';
const {title, image, subtitle, description, kind = '', lang, path} = Astro.props;
---
<header class:list={['pkt-hero', kind]}>
  <img class="pkt-hero__image" src={image} alt="" fetchpriority="high" />
  <div class="pkt-hero__shade"></div>
  <TopNav lang={lang} path={path} />
  <h1 class="pkt-hero__title">{title}</h1>
  {subtitle && <p class="pkt-hero__subtitle">{subtitle}</p>}
  {description && <p class="pkt-hero__description">{description}</p>}
</header>
