---
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/navigation.css';
import NavPreview from '../components/NavPreview.astro';
import {locales} from '../../../locales';
const {title, description, lang = 'it', pageClass = ''} = Astro.props;
const route = '/' + Astro.url.pathname.split('/').slice(2).join('/');
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{title} — PKT</title>{description && <meta name="description" content={description}/>}<link rel="canonical" href={`${import.meta.env.SITE_BASE_URL || 'https://giovannipivatoo.github.io/pkt'}/${lang}${route}`}/>{locales.map(locale => <link rel="alternate" hreflang={locale} href={`${import.meta.env.SITE_BASE_URL || 'https://giovannipivatoo.github.io/pkt'}/${locale}${route}`}/>)}<link rel="preload" href="/fonts/ApfelGrotezk-Mittel.woff2" as="font" type="font/woff2" crossorigin/><link rel="icon" href="/images/logo.svg" type="image/svg+xml"/></head><body class={pageClass}><a class="skip-link" href="#main">Salta al contenuto</a><slot/><NavPreview/><script is:inline src="/scripts/motion.js" defer></script></body></html>
